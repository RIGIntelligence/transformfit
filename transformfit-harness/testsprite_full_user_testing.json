{
  "schema": "transformfit.testsprite_full_user_testing.v1",
  "version": "1.0.0",
  "created_at": "2026-07-02",
  "truth_status": {
    "real_recruited_user_testing_complete": false,
    "live_testsprite_cloud_run_complete": false,
    "local_deterministic_user_testing_complete": true,
    "reason": "Direct outreach, paid recruiting, public posting, deploys, and credential changes remain out of scope. TestSprite CLI is installed, but the active API key is invalid/revoked or the provider auth endpoint may be unavailable, so this harness proves the TestSprite command contract plus deterministic local coverage without claiming a cloud run."
  },
  "testsprite": {
    "cli": "testsprite",
    "mode": "cli_contract_plus_dry_run",
    "cloud_run_status": "blocked_auth_invalid_or_no_public_url",
    "required_commands": [
      "testsprite --version",
      "testsprite --dry-run --output json project list",
      "testsprite --dry-run --output json test create-batch --plans <generated-jsonl>",
      "testsprite --output json auth status"
    ],
    "docs": [
      {
        "id": "testsprite-command-reference",
        "url": "https://docs.testsprite.com/cli/reference/command-reference",
        "lesson": "Use --output json as the stable agent/CI contract; --dry-run skips network and credentials while returning OpenAPI-shaped samples."
      },
      {
        "id": "testsprite-creating-tests",
        "url": "https://docs.testsprite.com/cli/core/creating-tests",
        "lesson": "Frontend TestSprite tests are plan files with projectId, type, name, and planSteps; create-batch supports up to 50 plan specs."
      },
      {
        "id": "testsprite-localhost-boundary",
        "url": "https://docs.testsprite.com/cli/getting-started/quickstart",
        "lesson": "The CLI requires a public http/https target URL for cloud runs; localhost targets require the TestSprite MCP tunnel."
      }
    ]
  },
