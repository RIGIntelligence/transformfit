  "ux_principles": [
    {
      "id": "uxp_fast_active_logging",
      "source_ids": [
        "src_macrofactor_workouts_product",
        "src_hevy_app_store_preview",
        "src_liftoff_app_store_preview"
      ],
      "target_screen_ids": [
        "active_workout_log",
        "today"
      ],
      "screen_observable": true,
      "principle": "The workout logger must prioritize fast repeated set entry, immediate undo, timer context, and previous-performance recall over decorative layout."
    },
    {
      "id": "uxp_readiness_adjusted_next_action",
      "source_ids": [
        "src_macrofactor_workouts_google_play",
        "src_fitbod_app_store_preview",
        "src_ladder_app_store_preview"
      ],
      "target_screen_ids": [
        "onboarding_intake",
        "plan_reveal",
        "today",
        "active_workout_log"
      ],
      "screen_observable": true,
      "principle": "The user should always see the next appropriate action adjusted to plan, readiness, and recent context."
    },
    {
      "id": "uxp_explain_plan_before_ask",
      "source_ids": [
        "src_cal_ai_app_store_preview",
        "src_macrofactor_macro_tracker_app_store",
        "src_fitbod_app_store_preview"
      ],
      "target_screen_ids": [
        "onboarding_intake",
        "plan_reveal",
        "first_session_handoff"
      ],
      "screen_observable": true,
      "principle": "Personalization must explain why it is asking and what changed in the plan before asking the user to trust the result."
    },
    {
      "id": "uxp_progress_without_body_shame",
      "source_ids": [
        "src_strava_app_store_preview",
        "src_garmin_app_store_preview",
        "src_hevy_app_store_preview"
      ],
      "target_screen_ids": [
        "progress",
        "proof_card",
        "profile"
      ],
      "screen_observable": true,
      "principle": "Progress and sharing surfaces should emphasize completed behavior, strength, recovery, and consistency instead of body-ranking or before/after framing."
    },
    {
      "id": "uxp_coach_voice_with_data_token",
      "source_ids": [
        "src_macrofactor_macro_tracker_app_store",
        "src_nike_run_club_app_store_preview",
        "src_calm_health_app_store_preview"
      ],
      "target_screen_ids": [
        "today",
        "plan_reveal",
        "progress",
        "active_workout_log"
      ],
      "screen_observable": true,
      "principle": "Coach copy must be short, specific, and grounded in one data token or user phrase so the user feels recognized rather than managed by generic motivation."
    },
    {
      "id": "uxp_recovery_as_kept_promise",
      "source_ids": [
        "src_calm_health_app_store_preview",
        "src_garmin_app_store_preview",
        "src_macrofactor_workouts_google_play"
      ],
      "target_screen_ids": [
        "today",
        "active_workout_log",
        "progress"
      ],
      "screen_observable": true,
      "principle": "Low-readiness days must count an appropriate recovery action as completion, not failure."
    },
    {
      "id": "uxp_goal_to_session_continuity",
      "source_ids": [
        "src_ladder_app_store_preview",
        "src_nike_run_club_app_store_preview",
        "src_fitbod_app_store_preview"
      ],
      "target_screen_ids": [
        "welcome",
        "first_session_handoff",
        "active_workout_log"
      ],
      "screen_observable": true,
      "principle": "The path from promise to first session must feel continuous: goal, plan, first action, and live logger should share vocabulary and state."
    },
    {
      "id": "uxp_safety_boundary_at_action_point",
      "source_ids": [
        "src_calm_health_app_store_preview",
        "src_garmin_app_store_preview",
        "src_macrofactor_workouts_google_play"
      ],
      "target_screen_ids": [
        "today",
        "active_workout_log",
        "progress"
      ],
      "screen_observable": true,
      "principle": "When pain or injury risk appears, the coach must surface a stop/modify boundary at the action point before any progression cue."
    },
    {
      "id": "uxp_audit_the_research_claim",
      "source_ids": [
        "src_macrofactor_workouts_product",
        "src_hevy_app_store_preview",
        "src_ux_ui_scraper_repo_requested"
      ],
      "target_screen_ids": [
        "plan_reveal",
        "active_workout_log",
        "progress",
        "proof_card"
      ],
      "screen_observable": true,
      "principle": "No design lesson is treated as shipped proof unless it cites a real source ID; missing research repos remain named gaps rather than hidden assumptions."
    }
