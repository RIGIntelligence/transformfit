# TransformFit app - environment template (safe to commit; contains NO secrets)
# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase (client-side, safe to expose: publishable/anon key + URL) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Supabase project ref (for management/migrations; not a secret) ---
SUPABASE_PROJECT_REF=

# --- OpenRouter (SERVER-SIDE ONLY - set as a Supabase Edge Function secret) ---
# Do NOT ship this to the Flutter web client. The coaching engine calls
# OpenRouter from a Supabase Edge Function so the key stays server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.1
